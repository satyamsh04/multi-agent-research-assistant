# Copy this file to .env and fill in your keys. NEVER commit the real .env —
# it is already listed in .gitignore.

# OpenAI — powers the GPT-4o-mini fallback used when the local OpenClaw gateway
# is not reachable. Required for the app to run end-to-end without a gateway.
OPENAI_API_KEY=your_openai_key_here

# Model used on the OpenAI fallback path. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini

# Serper — powers the Researcher's live web search. If left blank the Researcher
# falls back to model knowledge and the UI shows a warning.
SERPER_API_KEY=your_serper_key_here

# OpenClaw — honoured for parity with the OpenClaw spec. The local gateway does
# not require this key, but downstream tools may. Leave blank to use the OpenAI
# fallback exclusively.
OPENCLAW_API_KEY=your_openclaw_key_here

# Maximum number of Writer drafts in the Critic revision loop (1-5, default 3).
# MAX_CRITIQUE_ITERATIONS takes precedence over MAX_WRITER_DRAFTS if both set.
MAX_CRITIQUE_ITERATIONS=3
